{
  "name": "@pi-bot/shared",
  "version": "0.1.0",
  "description": "Shared TypeScript types for pi-bot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "echo 'No tests for shared types package'",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "files": [
    "dist"
  ],
  "keywords": ["pi-bot", "types"],
  "author": "pi-bot contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/luodaoyi/pi-bot.git",
    "directory": "packages/shared"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
