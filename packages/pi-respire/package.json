{
  "name": "pi-respire",
  "version": "0.1.0",
  "description": "Pi extension for Respire memory system integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "keywords": [
    "pi-package",
    "respire",
    "memory",
    "coding-agent"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "author": "pi-bot contributors",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@sinclair/typebox": "*"
  },
  "dependencies": {
    "@pi-bot/respire-client": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@types/node": "^22.10.2",
    "@sinclair/typebox": "^0.34.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
