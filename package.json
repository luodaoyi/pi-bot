{
  "name": "pi-bot-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source port of DeepSeek-Bot to pi coding agent with Respire memory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luodaoyi/pi-bot.git"
  },
  "author": "pi-bot contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='!@pi-bot/web' build",
    "dev": "pnpm -r --parallel --filter='!@pi-bot/web' dev",
    "test": "pnpm -r --filter='!@pi-bot/web' test",
    "test:watch": "pnpm -r --parallel --filter='!@pi-bot/web' test:watch",
    "lint": "pnpm -r --filter='!@pi-bot/web' lint",
    "lint:fix": "pnpm -r --filter='!@pi-bot/web' lint:fix",
    "typecheck": "pnpm -r --filter='!@pi-bot/web' typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1"
  }
}
