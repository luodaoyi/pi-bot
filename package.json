{
  "name": "pi-agent-bot",
  "version": "0.1.0-beta.3",
  "description": "Multi-bot daemon with Pi SDK, Respire memory, team coordination, and web GUI for managing AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-bot": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "#shared/*": "./dist/shared/*.js",
    "#respire-client/*": "./dist/respire-client/*.js",
    "#respire-extension/*": "./dist/respire-extension/*.js",
    "#daemon/*": "./dist/daemon/*.js"
  },
  "pi": {
    "name": "pi-agent-bot",
    "description": "Multi-bot daemon with Pi SDK, Respire memory, team coordination, and web GUI for managing AI agents",
    "main": "./dist/index.js",
    "extensions": [
      "./dist/respire-extension/index.js"
    ],
    "homepage": "https://github.com/luodaoyi/pi-bot#readme"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi",
    "multi-agent",
    "bot-daemon",
    "respire",
    "ai-agents",
    "team-coordination"
  ],
  "scripts": {
    "prepack": "npm run build && npm run build:web && npm run copy-web",
    "copy-web": "node scripts/copy-web.cjs",
    "build": "tsc -b && npx tsc-alias",
    "build:web": "cd web && npm install --legacy-peer-deps && npm run build",
    "dev": "tsx watch src/daemon/cli.ts serve --dev",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo web/dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "author": "pi-bot contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luodaoyi/pi-bot.git"
  },
  "homepage": "https://github.com/luodaoyi/pi-bot#readme",
  "bugs": {
    "url": "https://github.com/luodaoyi/pi-bot/issues"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@sinclair/typebox": "^0.34.24",
    "croner": "^10.0.1",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.2",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "comments": {
    "engines": "node:sqlite requires Node.js >= 22.5.0, pi requires >= 22.19.0"
  }
}
