{
  "name": "pi-bot",
  "version": "0.1.0",
  "description": "Multi-bot daemon with Pi SDK and Respire memory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-bot": "./dist/cli.js"
  },
  "pi": {
    "name": "pi-bot",
    "version": "0.1.0",
    "description": "Multi-bot daemon with Pi SDK and Respire memory",
    "main": "./dist/index.js",
    "extensions": [
      "./dist/respire-extension/index.js"
    ]
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pi-bot",
    "pi-package",
    "multi-agent",
    "respire"
  ],
  "scripts": {
    "prepack": "npm run build && npm run build:web && npm run copy-web",
    "copy-web": "rm -rf dist/web && mkdir -p dist/web && cp -r web/dist/* dist/web/",
    "build": "tsc -b",
    "build:web": "cd web && npm install --legacy-peer-deps && npm run build",
    "dev": "tsx watch src/daemon/cli.ts serve --dev",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo web/dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "author": "pi-bot contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/luodaoyi/pi-bot.git"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@sinclair/typebox": "^0.34.24",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
